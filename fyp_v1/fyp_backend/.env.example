# ---------------------------------------------------------------------------
# Backend environment variables — copy this file to ".env" and fill in values.
# The real ".env" is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb://localhost:27017/fyp

# Secret used to encrypt/decrypt passwords (crypto-js)
SECRET=change_me_to_a_long_random_string

# Secret used to sign JWT auth tokens
JWT_SEC=change_me_to_another_long_random_string

# Gmail (or SMTP) account used to send OTP emails via nodemailer
EMAIL=your_email@gmail.com
PASSWORD=your_email_app_password
